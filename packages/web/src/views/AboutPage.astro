            <HoloCard from="bottom" delay={0.3} hue="var(--color-empathogen)" rest={6} class="lp-card-edition" molecule="mushrooms" backLabel="Pilot edition">
              <Face kicker="Pilot edition" spine="Pilot edition · 100 numbered sets" foot="QR → live corrections">
                <p class="pc-edition__no"><small>No.</small>001<small>/100</small></p>
                <span class="pc-seal" style="--mask: url(/assets/molecules/mushrooms.png)" aria-hidden="true"></span>

{
  "name": "psy.cards",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @psy.cards/web dev",
    "build": "pnpm --filter @psy.cards/web build",
    "preview": "pnpm --filter @psy.cards/web preview",
    "preview:cloudflare": "pnpm --filter @psy.cards/web preview:cloudflare",
    "import:wikipedia-combos": "pnpm --filter @psy.cards/web import:wikipedia-combos",
    "i18n:extract": "pnpm --filter @psy.cards/web i18n:extract",
    "i18n:fill": "pnpm --filter @psy.cards/web i18n:fill",
    "i18n:check": "pnpm --filter @psy.cards/web i18n:check",
    "print:pdf": "pnpm --filter @psy.cards/web print:pdf",
    "smoke:worker-routes": "pnpm --filter @psy.cards/web smoke:worker-routes",
    "datapack": "pnpm --filter @psy.cards/shared datapack",
    "ios:generate": "cd packages/ios && xcodegen generate",
    "generate-types": "pnpm --filter @psy.cards/web generate-types"
  }
}

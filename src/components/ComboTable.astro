---
import CategoryNav from "./CategoryNav.astro";
import ComboCell from "./ComboCell.astro";
import type { Locale } from "../i18n/locales";
import { getColumns, commonSubstanceKeySet, sortPair } from "../data/config";
import { getInteraction } from "../data/combos";
import { pairSlug } from "../data/slug";
import { getUiMessages } from "../i18n/load-locale";
import { t } from "../i18n/ui";
import { localePath } from "../i18n/locales";

interface Props {
  locale?: Locale;
  comboRoute?: string;
  substanceBase?: string;
  initialSubstanceSet?: "common" | "full";
}

const {
  locale = "en",
  comboRoute = localePath(locale, "/combos"),
  substanceBase: substanceBaseProp = localePath(locale, "/"),
  initialSubstanceSet = "full",
} = Astro.props;

const columns = getColumns(locale);
const ui = getUiMessages(locale);
const substanceBase = substanceBaseProp.endsWith("/")
  ? substanceBaseProp
  : `${substanceBaseProp}/`;
const tooltipNotes: Record<string, string> = {};

for (let rowIndex = 0; rowIndex < columns.length; rowIndex += 1) {
  for (let colIndex = rowIndex + 1; colIndex < columns.length; colIndex += 1) {
    const rowKey = columns[rowIndex]!.key;
    const colKey = columns[colIndex]!.key;
    const note = getInteraction(rowKey, colKey, locale).note;
    if (!note) continue;

    const [keyA, keyB] = sortPair(locale, rowKey, colKey);
    tooltipNotes[pairSlug(keyA, keyB)] = note;
  }
}

const tooltipNotesJson = JSON.stringify(tooltipNotes).replaceAll("<", "\\u003c");

const isCommonSubstance = (key: string) => commonSubstanceKeySet.has(key);

function getLabelSizeClass(label: string) {
  if (label.length >= 11) return "label-xs";
  if (label.length >= 8) return "label-sm";
  return "label-md";
}

function getDisplayLabel(label: string) {
  return label.replaceAll("-", "\u2011");
}
---

<div class="combo-table-block">
<section
  class="table-wrap"
  aria-label={t(locale, ui, "comboTable.ariaLabel")}
  data-medication="true"
  data-hover-enabled="true"
  data-substance-set={initialSubstanceSet}
>
  <script
    is:inline
    type="application/json"
    data-combo-tooltip-notes
    set:html={tooltipNotesJson}
  ></script>
  <div class="shadow-left" aria-hidden="true" data-table-shadow></div>
  <div class="table-head-stick">
    <button
      class="corner search-trigger"
      type="button"
      aria-label={t(locale, ui, "comboTable.searchAriaLabel")}
      title={t(locale, ui, "comboTable.searchTitle")}
      data-search-trigger
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M10.75 4a6.75 6.75 0 1 0 4.16 12.06l3.52 3.51 1.41-1.41-3.51-3.52A6.75 6.75 0 0 0 10.75 4Zm0 2a4.75 4.75 0 1 1 0 9.5 4.75 4.75 0 0 1 0-9.5Z"
        ></path>
      </svg>
      <span class="search-trigger-label">{t(locale, ui, "comboTable.search")}</span>
      <kbd class="search-trigger-kbd" aria-hidden="true">
        <span class="search-trigger-kbd__mac">⌘F</span>
        <span class="search-trigger-kbd__win">Ctrl+F</span>
      </kbd>
    </button>
    <div class="table-head-scroll" data-head-scroll>
      <table class="combos-table combos-table--head" role="presentation">
        <thead>
          <tr>
            {
              columns.map((col) => (
                <th
                  scope="col"
                  class={`col-head group-${col.group} category-surface cell-text ${getLabelSizeClass(col.label)}`}
                  data-substance-slug={col.slug}
                  data-col-key={col.key}
                  data-col-group={col.group}
                  data-col-common={String(isCommonSubstance(col.key))}
                  data-hover-cell
                >
                  <a
                    href={`${substanceBase}${col.slug}`}
                    class="label-link col-link"
                    data-substance={`${substanceBase}${col.slug}`}
                  >
                    <span class="label-text">{getDisplayLabel(col.label)}</span>
                  </a>
                </th>
              ))
            }
          </tr>
        </thead>
      </table>
    </div>
  </div>

  <div class="table-scroll" role="region" tabindex="0" data-body-scroll>
    <table class="combos-table combos-table--body" role="grid">
      <tbody>
        {
          columns.map((row) => (
            <tr data-row-substance={row.key} data-row-common={String(isCommonSubstance(row.key))}>
              <th
                scope="row"
                class={`row-head group-${row.group} category-surface cell-text ${getLabelSizeClass(row.label)}`}
                data-substance-slug={row.slug}
                data-row-key={row.key}
                data-row-group={row.group}
                data-row-common={String(isCommonSubstance(row.key))}
                data-hover-cell
              >
                <a
                  href={`${substanceBase}${row.slug}`}
                  class="label-link row-link"
                  data-substance={`${substanceBase}${row.slug}`}
                >
                  <span class="label-text">{getDisplayLabel(row.label)}</span>
                </a>
              </th>
              {columns.map((col) =>
                row.key === col.key ? (
                  <th
                    scope="col"
                    class={`diag group-${row.group} category-surface cell-text ${getLabelSizeClass(row.label)}`}
                    data-row-key={row.key}
                    data-col-key={col.key}
                    data-row-group={row.group}
                    data-col-group={col.group}
                    data-row-common={String(isCommonSubstance(row.key))}
                    data-col-common={String(isCommonSubstance(col.key))}
                    data-hover-cell
                  >
                    <a
                      href={`${substanceBase}${row.slug}`}
                      class="label-link diag-link"
                      data-substance={`${substanceBase}${row.slug}`}
                    >
                      <span class="label-text">{getDisplayLabel(row.label)}</span>
                    </a>
                  </th>
                ) : (
                  <td
                    class="cell-td"
                    data-row-key={row.key}
                    data-col-key={col.key}
                    data-row-group={row.group}
                    data-col-group={col.group}
                    data-row-common={String(isCommonSubstance(row.key))}
                    data-col-common={String(isCommonSubstance(col.key))}
                    data-hover-cell
                  >
                    <ComboCell
                      rowKey={row.key}
                      colKey={col.key}
                      rowLabel={row.label}
                      colLabel={col.label}
                      comboRoute={comboRoute}
                      locale={locale}
                    />
                  </td>
                )
              )}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<CategoryNav locale={locale} initialSubstanceSet={initialSubstanceSet} />
</div>

<script>
  import { initComboTables } from "../scripts/combo-table";
  import { initSearchPalette } from "../scripts/search-palette";

  initComboTables();
  initSearchPalette();
</script>

<style>
  .combo-table-block {
    position: relative;
    --category-nav-height: 118px;
    padding-bottom: var(--category-nav-height);
    user-select: none;
    -webkit-user-select: none;
  }

  .table-wrap {
    --cell-gap: 2px;
    --fluid-cell-width: calc((100cqi - 56px) / 27);
    --table-cell-width: max(92px, var(--fluid-cell-width));
    --table-cell-height: clamp(48px, calc(var(--table-cell-width) * 0.55), 58px);
    --table-header-height: calc(var(--table-cell-height) + var(--cell-gap) * 2);
    --table-cell-size: var(--table-cell-width);
    --cell-size: var(--table-cell-height);
    --row-head-size: calc(var(--table-cell-width) + var(--cell-gap));
    --ink: var(--color-ink);
    width: 100%;
    padding: 0;
    position: relative;
    container-type: inline-size;
  }

  .table-wrap[data-substance-set="common"] {
    --fluid-cell-width: calc((100cqi - 26px) / 12);
    --table-cell-width: max(104px, var(--fluid-cell-width));
  }

  .table-head-stick {
    position: sticky;
    top: 0;
    z-index: 8;
    display: grid;
    grid-template-columns: var(--row-head-size) 1fr;
    align-items: stretch;
    height: var(--table-header-height);
    background-color: var(--ink);
  }

  .table-head-stick::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 14px;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.28), transparent);
    opacity: 0.55;
  }

  .table-head-scroll {
    height: var(--table-header-height);
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    overscroll-behavior-y: auto;
    touch-action: pan-x pan-y pinch-zoom;
    background-color: var(--ink);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .table-head-scroll::-webkit-scrollbar {
    display: none;
  }

  .shadow-left {
    position: absolute;
    top: var(--table-header-height);
    left: var(--row-head-size);
    height: calc((var(--table-cell-height) + var(--cell-gap)) * 25);
    width: 14px;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.28), transparent);
    opacity: 0;
    transition: opacity 140ms ease;
    z-index: 7;
  }

  .table-wrap[data-scrolled-x="true"] .shadow-left {
    opacity: 1;
  }

  .table-scroll {
    position: relative;
    width: 100%;
    overflow-x: auto;
    overflow-y: visible;
    overscroll-behavior-x: contain;
    overscroll-behavior-y: auto;
    touch-action: pan-x pan-y pinch-zoom;
    background-color: var(--ink);
    -webkit-overflow-scrolling: touch;
  }

  .table-scroll:focus-visible {
    outline: none;
  }

  .combos-table {
    border-collapse: separate;
    border-spacing: var(--cell-gap);
    background-color: var(--ink);
    font-size: clamp(15px, calc(var(--table-cell-size) * 0.2), 28px);
    table-layout: fixed;
    width: max-content;
    min-width: max-content;
  }

  .combos-table th,
  .combos-table td {
    padding: 0;
    margin: 0;
    width: var(--table-cell-width);
    height: var(--table-cell-height);
    min-width: var(--table-cell-width);
    max-width: var(--table-cell-width);
    box-sizing: border-box;
    overflow: hidden;
  }

  .table-wrap[data-substance-set="common"] [data-col-common="false"],
  .table-wrap[data-substance-set="common"] [data-row-common="false"] {
    display: none;
  }

  [data-hover-cell] {
    transition: opacity 160ms ease;
  }

  .table-wrap[data-hovering="true"] [data-hover-cell] {
    opacity: 0.42;
    transition-duration: 0ms;
  }

  .table-wrap[data-hovering="true"] [data-hover-cell].is-highlight {
    opacity: 1;
  }

  .corner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    background-color: var(--ink);
    width: var(--row-head-size);
    min-width: var(--row-head-size);
    height: var(--table-header-height);
    min-height: 0;
    overflow: hidden;
    box-sizing: border-box;
    touch-action: pan-y pinch-zoom;
  }

  .search-trigger {
    flex-direction: column;
    padding: 4px 5px;
    color: var(--color-fg);
    border: 0;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    cursor: pointer;
  }

  .search-trigger svg {
    width: clamp(18px, calc(var(--table-cell-size) * 0.23), 22px);
    height: clamp(18px, calc(var(--table-cell-size) * 0.23), 22px);
    fill: currentColor;
    opacity: 0.85;
  }

  .search-trigger-label {
    display: block;
    max-width: 100%;
    overflow: hidden;
    color: rgba(255, 255, 255, 0.6);
    font-size: clamp(9px, calc(var(--table-cell-size) * 0.105), 12px);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .search-trigger-kbd {
    display: none;
    margin-top: 3px;
    padding: 0;
    color: rgba(255, 255, 255, 0.38);
    background: none;
    border: 0;
    font-family: inherit;
    font-size: clamp(8px, calc(var(--table-cell-size) * 0.09), 10px);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  .search-trigger-kbd__win {
    display: none;
  }

  :global(html[data-mod-key="ctrl"]) .search-trigger-kbd__mac {
    display: none;
  }

  :global(html[data-mod-key="ctrl"]) .search-trigger-kbd__win {
    display: inline;
  }

  @media (pointer: coarse) {
    .search-trigger-kbd {
      display: none;
    }
  }

  .search-trigger:hover svg,
  .search-trigger:focus-visible svg {
    opacity: 1;
  }

  :global(html[data-color-scheme="light"]) .search-trigger {
    color: var(--color-fg);
    border-right-color: rgba(23, 24, 19, 0.1);
  }

  :global(html[data-color-scheme="light"]) .search-trigger-label {
    color: var(--color-fg-mute);
  }

  :global(html[data-color-scheme="light"]) .search-trigger-kbd {
    color: rgba(23, 24, 19, 0.42);
  }

  .table-wrap[data-medication="false"] tr[data-row-substance="maois"],
  .table-wrap[data-medication="false"] tr[data-row-substance="ssris"] {
    display: none;
  }

  .table-wrap[data-medication="false"] th[data-col-key="maois"],
  .table-wrap[data-medication="false"] th[data-col-key="ssris"],
  .table-wrap[data-medication="false"] td[data-col-key="maois"],
  .table-wrap[data-medication="false"] td[data-col-key="ssris"] {
    display: none;
  }

  .is-row-hidden {
    display: none !important;
  }

  .is-col-hidden {
    display: none !important;
  }

  .col-head {
    height: var(--table-cell-height);
    min-height: var(--table-cell-height);
    width: var(--table-cell-width);
    min-width: var(--table-cell-width);
    padding: 0;
  }

  .label-link {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: clamp(5px, calc(var(--table-cell-size) * 0.075), 12px);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    box-sizing: border-box;
  }

  .col-head .label-text,
  .row-head .label-text {
    display: inline-block;
    font-weight: 750;
    font-size: clamp(14px, calc(var(--table-cell-size) * 0.155), 20px);
    letter-spacing: 0.02em;
    line-height: 1.02;
    text-align: left;
    white-space: normal;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
    -webkit-hyphens: none;
    max-width: 100%;
  }

  .col-head .label-link,
  .row-head .label-link {
    justify-content: flex-start;
  }

  .row-head {
    position: sticky;
    left: 0;
    z-index: 3;
    width: var(--table-cell-width);
    min-width: var(--table-cell-width);
    background-clip: padding-box;
    box-shadow: inset -1px 0 0 rgba(255, 255, 255, 0.04);
  }

  .row-head .row-link {
    font-size: inherit;
  }

  .row-head .row-link:hover,
  .col-head .label-link:hover {
    filter: brightness(1.2);
  }

  .diag .diag-link {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 0;
    text-decoration: none;
    color: inherit;
  }

  .diag .label-text {
    display: inline-block;
    transform: rotate(-45deg);
    font-weight: 700;
    font-size: clamp(12px, calc(var(--table-cell-size) * 0.13), 17px);
    white-space: nowrap;
    line-height: 1;
    opacity: 0.9;
  }

  .label-xs .label-text {
    font-size: clamp(11.5px, calc(var(--table-cell-size) * 0.115), 15px);
    letter-spacing: 0;
  }

  .label-sm .label-text {
    font-size: clamp(13px, calc(var(--table-cell-size) * 0.135), 17px);
  }

  .label-md .label-text {
    font-size: clamp(14px, calc(var(--table-cell-size) * 0.15), 19px);
  }

  .cell-td {
    padding: 0;
    background-color: var(--ink);
  }

  .combos-table td.cell-td {
    position: relative;
  }

  @media (max-width: 640px) {
    .table-wrap {
      --fluid-cell-width: 80px;
      --table-cell-width: 80px;
      --table-cell-height: 44px;
    }

    .table-wrap[data-substance-set="common"] {
      --fluid-cell-width: 90px;
      --table-cell-width: 90px;
      --table-cell-height: 48px;
    }

    .combos-table {
      font-size: 17px;
    }

    .label-xs .label-text {
      font-size: 10.5px;
    }

    .label-sm .label-text {
      font-size: 12px;
    }

    .label-md .label-text {
      font-size: 13.5px;
    }

    .search-trigger {
      padding: 3px 4px;
    }

    .search-trigger-label {
      font-size: 8px;
    }

    .search-trigger-kbd {
      margin-top: 2px;
      font-size: 7px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-hover-cell] {
      transition: none !important;
    }

    .search-trigger {
      transition: none !important;
    }
  }
</style>

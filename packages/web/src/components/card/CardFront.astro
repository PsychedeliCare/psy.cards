---
import { Icon } from "@twodft/astro-icon/components";
import DoseScale from "./DoseScale.astro";
import EffectCurve from "./EffectCurve.astro";
import { buildEffectCurve } from "../../lib/effect-curve";
import { getDisplayLabel } from "../../data/config";
import MoleculeFigure from "../MoleculeFigure.astro";
import { getRouteIcon, getRouteLabel, type DoseChart } from "../../lib/dose-chart";
import type { CardData } from "../../data/harm-reduction";
import { keyToSlug } from "../../data/slug";
import type { Locale } from "../../i18n/locales";
import { getUiMessages } from "../../i18n/load-locale";
import { t, tFormat } from "../../i18n/ui";

interface Props {
  data: CardData;
  locale: Locale;
  uid: string;
  displayName: string;
  groupLabel?: string;
  aliases: string[];
  hasStructure: boolean;
}

const { data, locale, uid, displayName, groupLabel, aliases, hasStructure } = Astro.props;
const ui = getUiMessages(locale);
const c = data.content;
const primary = data.primary?.chartable ? (data.primary as DoseChart) : undefined;
const otherRoutes = data.otherRoutes;
const personal = data.personal;
const mdmaMarker = personal?.kind === "mgPerKg" ? { male: personal.male, female: personal.female } : undefined;
const commonSegment = primary?.segments.find((segment) => segment.level === "common");
const showDoseTip = Boolean(primary && c.dose && personal?.kind !== "perKgChart");
const showSideTile = Boolean(personal) || showDoseTip;

const curve = buildEffectCurve(data.timing);
const effects = c.effects ?? [];
const alcoholLabel = getDisplayLabel(locale, "alcohol");

const margin = data.margin;
const marginPos = margin ? Math.min(100, (Math.log10(margin.ratio) / 3) * 100) : 0;
const marginText = margin
  ? tFormat(locale, ui, margin.atLeast ? "card.marginAtLeast" : "card.marginLabel", { ratio: String(margin.ratio) })
  : t(locale, ui, "card.marginUnknown");
const alcoholRatio = data.gable.find((row) => row.key === "alcohol")?.ratio ?? 10;
const showAlcoholTick = data.key !== "alcohol";
const routesPopover = `${uid}-routes`;
const marginPopover = `${uid}-margin`;
const routeName = (route: string) => getRouteLabel(route);
---

<section class="psy-face psy-face--front" id={`${uid}-front`} aria-labelledby={`${uid}-title`} data-hologram-host>
  <span class="psy-foil" aria-hidden="true"></span>
  {hasStructure && (
    <canvas
      class="substance-hologram"
      data-molecule-mask={`/assets/molecules/${keyToSlug(data.key)}.png`}
      aria-hidden="true"
    />
  )}
  <MoleculeFigure substanceKey={data.key} />

  <header class="psy-head">
    {groupLabel && <p class="psy-head__group category-surface cell-text">{groupLabel}</p>}
    <h2 class:list={["psy-head__title", { "psy-head__title--long": displayName.length > 11 }]} id={`${uid}-title`}>{displayName}</h2>
    {aliases.length > 0 && <p class="psy-head__aliases">{aliases.slice(0, 4).join(" · ")}</p>}
  </header>

  <div class="psy-bento">
    <section class="psy-tile psy-tile--dose" aria-labelledby={`${uid}-dose`}>
      <div class="psy-tile__head">
        <h3 id={`${uid}-dose`}>
          <Icon name="ph:scales-fill" aria-hidden="true" />
          {t(locale, ui, "card.dose")}
          {data.referenceName && primary && (
            <span class="psy-ref" title={tFormat(locale, ui, "card.reference", { name: data.referenceName })}>
              {data.referenceName}
            </span>
          )}
        </h3>
        {data.primary && (
          <span class="psy-route">
            <Icon name={`ph:${getRouteIcon(data.primary.route)}`} aria-hidden="true" />
            {routeName(data.primary.route)}
            {primary && <span class="psy-route__unit" data-dose-unit>{primary.unit}</span>}
          </span>
        )}
        {otherRoutes.length > 0 && (
          <button
            type="button"
            class="psy-chip-btn"
            popovertarget={routesPopover}
            aria-label={`${t(locale, ui, "card.otherRoutes")} (${otherRoutes.length})`}
          >
            {tFormat(locale, ui, "card.otherRoutesCount", { count: String(otherRoutes.length) })}
            <Icon name="ph:caret-down-bold" aria-hidden="true" />
          </button>
        )}
      </div>
      {primary ? (
        <DoseScale chart={primary} locale={locale} markerMgPerKg={mdmaMarker} widthEm={19.6} />
      ) : data.primary ? (
        <dl class="psy-dose-list">
          {(data.primary as { rows: { level: string; amount: string }[] }).rows.map((row) => (
            <div><dt>{row.level}</dt><dd>{row.amount}</dd></div>
          ))}
        </dl>
      ) : (
        <p class="psy-tile__text psy-tile__text--lead">{c.dose}</p>
      )}
      <div
        class:list={["psy-margin-row", { "is-unknown": !margin, "is-danger": data.marginDanger }]}
        aria-labelledby={`${uid}-margin-title`}
        role="group"
      >
        <h3 id={`${uid}-margin-title`}>
          <Icon name="ph:skull-fill" aria-hidden="true" />
          {t(locale, ui, "card.marginShort")}
        </h3>
        <div class="psy-margin" aria-hidden="true">
          <div class="psy-margin__track">
            {showAlcoholTick && (
              <span class="psy-margin__ref" style={`--x: ${(Math.log10(alcoholRatio) / 3) * 100}%`} title={alcoholLabel}>
                <Icon name="ph:wine-fill" />
              </span>
            )}
            {margin && (
              <span class:list={["psy-margin__dot", { "is-estimate": margin.extrapolated }]} style={`--x: ${marginPos}%`} />
            )}
          </div>
        </div>
        <span class="psy-margin__value" title={marginText}>
          {margin
            ? tFormat(locale, ui, "card.marginValue", { ratio: `${margin.atLeast ? ">" : ""}${margin.ratio}` })
            : t(locale, ui, "card.marginUnknown")}
          <span class="sr-only">. {marginText}{margin?.extrapolated ? `, ${t(locale, ui, "card.marginExtrapolated")}` : ""}</span>
        </span>
        <button type="button" class="psy-info-btn" popovertarget={marginPopover} aria-label={t(locale, ui, "card.marginCompare")}>
          <Icon name="ph:chart-bar-horizontal-fill" aria-hidden="true" />
        </button>
      </div>
      {!margin && c.marginNote && <p class="psy-tile__text psy-tile__text--small">{c.marginNote}</p>}
    </section>

    {(showSideTile || effects.length > 0) && (
      <div class="psy-row">
        {showSideTile && (
          <section
            class="psy-tile psy-tile--personal"
            data-personal={personal?.kind}
            data-male={personal?.kind === "mgPerKg" ? personal.male : personal?.kind === "bac" ? personal.rMale : undefined}
            data-female={personal?.kind === "mgPerKg" ? personal.female : personal?.kind === "bac" ? personal.rFemale : undefined}
            data-grams={personal?.kind === "bac" ? personal.gramsPerUnit : undefined}
            data-limit={personal?.kind === "bac" ? personal.limitPermille : undefined}
            data-per-kg={personal?.kind === "caffeine" ? personal.singleMgPerKg : undefined}
            data-max={personal?.kind === "caffeine" ? personal.singleMaxMg : undefined}
            data-daily={personal?.kind === "caffeine" ? personal.dailyMg : undefined}
            data-ref-weight={personal?.kind === "referenceWeight" ? personal.weightKg : undefined}
            data-min-kg={personal?.kind === "perKgChart" ? commonSegment?.start : undefined}
            data-max-kg={personal?.kind === "perKgChart" ? commonSegment?.end : undefined}
            aria-live="polite"
          >
            <h3>
              <Icon name={personal ? "ph:user-fill" : "ph:sparkle-fill"} aria-hidden="true" />
              {personal ? t(locale, ui, "card.forYou") : t(locale, ui, "card.startLow")}
            </h3>
            {personal && personal.kind !== "referenceWeight" && (
              <div class="psy-personal" data-personal-result hidden>
                <p class="psy-personal__value"><output data-personal-value></output></p>
                <p class="psy-personal__label" data-personal-label></p>
                <p class="psy-personal__formula" data-personal-formula></p>
              </div>
            )}
            {personal?.kind === "referenceWeight" && (
              <p class="psy-tile__text">
                {tFormat(locale, ui, "card.refWeight", { weight: String(personal.weightKg) })}{" "}
                <span data-personal-ref></span>
              </p>
            )}
            <p class="psy-tile__text" data-personal-empty={personal && personal.kind !== "referenceWeight" ? "" : undefined}>
              {personal?.kind === "bac"
                ? t(locale, ui, "card.setBody")
                : personal?.kind === "caffeine"
                  ? t(locale, ui, "card.setWeight")
                  : c.dose}
            </p>
          </section>
        )}
        {effects.length > 0 && (
          <section class="psy-tile psy-tile--effects" aria-labelledby={`${uid}-effects`}>
            <h3 id={`${uid}-effects`}>
              <Icon name="ph:sparkle-fill" aria-hidden="true" />
              {t(locale, ui, "substanceCard.effects")}
            </h3>
            <ul class="psy-effects">
              {effects.map((effect) => (
                <li><Icon name={`ph:${effect.icon}`} aria-hidden="true" />{effect.label}</li>
              ))}
            </ul>
          </section>
        )}
      </div>
    )}

    {curve && (
      <section class="psy-tile psy-tile--curve" aria-labelledby={`${uid}-curve`}>
        <h3 id={`${uid}-curve`}>
          <Icon name="ph:clock-fill" aria-hidden="true" />
          {t(locale, ui, "card.effectsOverTime")}
        </h3>
        <EffectCurve timing={data.timing} locale={locale} widthEm={19.6} />
      </section>
    )}

    {c.prepare && (
      <section class="psy-tile psy-tile--prepare" aria-labelledby={`${uid}-prepare`}>
        <h3 id={`${uid}-prepare`}>
          <Icon name="ph:test-tube-fill" aria-hidden="true" />
          {t(locale, ui, "card.prepare")}
        </h3>
        <p class="psy-tile__text">{c.prepare}</p>
        {(personal?.kind === "bac" || personal?.kind === "caffeine") && c.dose && (
          <p class="psy-tile__text psy-tile__text--note">{c.dose}</p>
        )}
      </section>
    )}
  </div>

  <footer class="psy-foot">
    <span class="psy-foot__brand">
      <img src="/favicon.png" alt="" width="14" height="14" />
      {t(locale, ui, "card.brand")}
    </span>
    <label class="psy-flip" for={`${uid}-side-back`}>
      {t(locale, ui, "card.flipToSafety")}
      <Icon name="ph:arrows-clockwise-bold" aria-hidden="true" />
    </label>
  </footer>
  <span class="psy-curl" aria-hidden="true"></span>
</section>

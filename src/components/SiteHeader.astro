---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import type { Locale } from "../i18n/locales";
import { localePath } from "../i18n/locales";
import { getUiMessages } from "../i18n/load-locale";
import { t } from "../i18n/ui";

interface Props {
  locale?: Locale;
  currentPath?: string;
  variant?: "default" | "event";
  /** When set, show Substances / Combos switcher in the header center. */
  activeView?: "list" | "combos";
}

const {
  locale = "en",
  currentPath = "/",
  variant = "default",
  activeView,
} = Astro.props;
const ui = getUiMessages(locale);
const homeHref = localePath(locale, "/");
const combosHref = localePath(locale, "/combos");
---

<header
  class:list={[
    "site-header",
    variant === "event" && "site-header--event",
    activeView && "site-header--with-view",
  ]}
>
  <h1 class="site-header__title">
    <a class="site-header__brand" href={homeHref}>
      <img src="/favicon.png" alt="" width="28" height="28" aria-hidden="true" />
      <span>PSY.CARDS</span>
    </a>
  </h1>

  {
    activeView && (
      <nav
        class="site-header__view"
        aria-label={t(locale, ui, "landing.viewSwitchAria")}
      >
        <ul>
          <li>
            <a
              href={homeHref}
              class:list={["view-link", activeView === "list" && "is-active"]}
              aria-current={activeView === "list" ? "page" : undefined}
            >
              {t(locale, ui, "landing.navList")}
            </a>
          </li>
          <li>
            <a
              href={combosHref}
              class:list={["view-link", activeView === "combos" && "is-active"]}
              aria-current={activeView === "combos" ? "page" : undefined}
            >
              {t(locale, ui, "landing.navCombos")}
            </a>
          </li>
        </ul>
      </nav>
    )
  }

  <div class="site-header__actions">
    <LanguageSwitcher locale={locale} currentPath={currentPath} />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
    padding: 10px 16px;
    background: color-mix(in oklab, var(--color-ink) 90%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  html[data-color-scheme="light"] .site-header {
    border-bottom-color: rgba(23, 24, 19, 0.08);
  }

  .site-header--with-view {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  }

  .site-header__title {
    margin: 0;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.18em;
    line-height: 1;
    justify-self: start;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--color-fg);
    text-decoration: none;
  }

  .site-header__brand img {
    display: block;
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  .site-header__brand:hover,
  .site-header__brand:focus-visible {
    color: var(--color-fg-mute);
  }

  .site-header__view {
    justify-self: center;
    grid-column: 2;
  }

  .site-header__view ul {
    display: inline-flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 4px;
    background: color-mix(in oklab, var(--color-ink-2), transparent 8%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
  }

  html[data-color-scheme="light"] .site-header__view ul {
    border-color: rgba(23, 24, 19, 0.1);
  }

  .site-header__view .view-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 28px;
    padding: 4px 12px;
    color: var(--color-fg-mute);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-decoration: none;
    border-radius: 999px;
  }

  .site-header__view .view-link:hover,
  .site-header__view .view-link:focus-visible {
    color: var(--color-fg);
  }

  .site-header__view .view-link.is-active {
    color: var(--color-ink);
    background: var(--color-fg);
  }

  .site-header__actions {
    justify-self: end;
    padding-right: 56px;
  }

  @media (max-width: 640px) {
    .site-header {
      gap: 8px;
      padding: 8px 10px;
    }

    .site-header--with-view {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .site-header__title {
      font-size: 11px;
      letter-spacing: 0.1em;
    }

    .site-header__brand {
      gap: 6px;
    }

    .site-header__brand span {
      white-space: nowrap;
    }

    .site-header__brand img {
      width: 22px;
      height: 22px;
    }

    .site-header__view ul {
      gap: 2px;
      padding: 3px;
    }

    .site-header__view .view-link {
      min-height: 24px;
      padding: 3px 8px;
      font-size: 10px;
    }

    .site-header__actions {
      padding-right: 34px;
    }

    .site-header__actions :global(.lang-switcher ul) {
      gap: 2px;
      padding: 3px;
    }

    .site-header__actions :global(.lang-link) {
      min-width: 26px;
      padding: 3px 6px;
      font-size: 10px;
    }
  }

  @media (max-width: 420px) {
    .site-header--with-view {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      row-gap: 8px;
    }

    .site-header__title {
      flex: 0 0 auto;
    }

    .site-header__actions {
      flex: 0 0 auto;
      margin-left: auto;
      padding-right: 28px;
    }

    .site-header__view {
      flex: 1 1 100%;
      order: 3;
      display: flex;
      justify-content: center;
      grid-column: unset;
      justify-self: unset;
    }
  }

  .site-header--event {
    background:
      radial-gradient(circle at 12% 0%, rgba(245, 167, 29, 0.22), transparent 52%),
      radial-gradient(circle at 88% 0%, rgba(223, 99, 48, 0.14), transparent 48%),
      linear-gradient(180deg, #f2ddb8 0%, #e8cfa0 100%);
    border-bottom: 1px solid rgba(223, 99, 48, 0.16);
    box-shadow: 0 6px 24px rgba(223, 99, 48, 0.07);
  }

  .site-header--event .site-header__brand {
    color: #372f4c;
  }

  .site-header--event .site-header__brand:hover,
  .site-header--event .site-header__brand:focus-visible {
    color: #df6330;
  }

  .site-header--event :global(.lang-switcher ul) {
    background: rgba(255, 250, 241, 0.72);
    border-color: rgba(55, 47, 76, 0.12);
  }

  .site-header--event :global(.lang-link) {
    color: rgba(55, 47, 76, 0.58);
  }

  .site-header--event :global(.lang-link:hover),
  .site-header--event :global(.lang-link:focus-visible) {
    color: #372f4c;
  }

  .site-header--event :global(.lang-link.is-active) {
    color: #372f4c;
    background: #fff0d2;
  }

  .site-header--event .site-header__view ul {
    background: rgba(255, 250, 241, 0.72);
    border-color: rgba(55, 47, 76, 0.12);
  }

  .site-header--event .site-header__view .view-link {
    color: rgba(55, 47, 76, 0.58);
  }

  .site-header--event .site-header__view .view-link:hover,
  .site-header--event .site-header__view .view-link:focus-visible {
    color: #372f4c;
  }

  .site-header--event .site-header__view .view-link.is-active {
    color: #372f4c;
    background: #fff0d2;
  }
</style>

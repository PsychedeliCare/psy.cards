---
/**
 * The project's landing page: why psy.cards exists, what a card is, and the
 * roadmap from the web app to a Europe-wide PsyCare network.
 *
 * It has its own shell (no app header or body dock) but renders real
 * substance cards, so it carries the same i18n payload as Layout.astro.
 * Every card on the page is A6 (105 × 148 mm), the size of the printed set.
 * The hero reuses the /logo three.js intro (scripts/logo/).
 */
import "../styles/global.css";
import "../styles/about.css";
import { Icon } from "@twodft/astro-icon/components";
import SubstanceCard from "../components/SubstanceCard.astro";
import HoloCard from "../components/about/HoloCard.astro";
import Face from "../components/about/Face.astro";
import Brand from "../components/about/Brand.astro";
import EuropeMap from "../components/about/EuropeMap.astro";
import DrugWheel from "../components/about/DrugWheel.astro";
import Device from "../components/about/Device.astro";
import AppScreen from "../components/about/AppScreen.astro";
import PsyCareScreen from "../components/about/PsyCareScreen.astro";
import PrintBox from "../components/about/PrintBox.astro";
import PartnerLogos from "../components/PartnerLogos.astro";
import { getColumns, getDisplayLabel, visibleGroupOrder, type GroupName } from "../data/config";
import { getInteraction } from "../data/combos";
import { getLocalInfo, listCountries } from "../data/local-info";
import { EUROPE_WAVES } from "../data/europe-waves";
import { keyToSlug } from "../data/slug";
import { qrCodeSvg } from "../lib/qr-code";
import { PWA_THEME_COLOR } from "../pwa-config";
import { getUiMessages } from "../i18n/load-locale";
import { locales, localePath, type Locale } from "../i18n/locales";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

// Outbound links in one place: swap them as channels open.
const LINKS = {
  webApp: localePath(locale, "/"),
  combos: localePath(locale, "/combos"),
  support: "https://psychedelicare.eu",
  partner: "https://psychedelicare.eu",
  github: "https://github.com/psychedelicare/psy.cards",
  sources: "/sources",
  euda: "https://www.euda.europa.eu/publications/european-drug-report/2025/drug-induced-deaths_en",
};

const ui = getUiMessages(locale);
const columns = getColumns(locale);
const substanceCount = columns.length;
const comboCount = (substanceCount * (substanceCount - 1)) / 2;
const countryCount = listCountries(locale).length;
const languageCount = locales.length;
const euLanguages = EUROPE_WAVES.flatMap((wave) => wave.languages).sort();
const liveLanguages: string[] = EUROPE_WAVES[0]!.languages;
const euLanguageCount = euLanguages.length;
const label = (key: string) => getDisplayLabel(locale, key);

const title = "PSY.CARDS — Harm reduction for all of Europe";
const description =
  "Verified harm-reduction information on two-sided A6 cards, for the web, native apps, social media and print, in every European language.";
const ogImage = new URL("/assets/opengraph.jpg", Astro.site ?? Astro.url.origin).href;
const i18nPayload = JSON.stringify({
  locale,
  ui,
  columns,
  comboRoute: LINKS.combos,
  substanceBase: localePath(locale, "/"),
});

// Hero: the /logo fan, one card per category with its emblematic molecule.
const moleculeByGroup: Partial<Record<GroupName, string>> = {
  stimulant: "amphetamines",
  empathogen: "mdma",
  psychedelic: "lsd",
  dissociative: "ketamine",
  depressant: "benzodiazepines",
  opioid: "opioids",
  cannabinoid: "cannabis",
};
const logoCards = visibleGroupOrder.map((group) => ({ group, slug: keyToSlug(moleculeByGroup[group]!) }));
const letters = [..."PSY.CARDS"];
const wordmarkTail = "CARDS";

// What the cards are built on (packages/shared/data/sources.json and the
// card sources in harm-reduction.json), in plain words.
const builtOn = [
  {
    title: "Data",
    items: [
      { name: "TripSit drug database", href: "https://github.com/TripSit/drugs", text: "Doses by route, onset and duration for every substance." },
      { name: "TripSit combination chart", href: "https://github.com/TripSit/combogen", text: `Risk ratings for all ${comboCount} pairs, and the ${substanceCount} substances it covers.` },
      { name: "PsychonautWiki", href: "https://psychonautwiki.org", text: "Effect descriptions, linked from each card." },
      { name: "The Drugs Wheel", href: "https://www.thedrugswheel.com/", text: "Mark Adley's seven categories, which group and colour the cards." },
      { name: "Country files", href: LINKS.sources, text: `Emergency numbers, drug laws and local services for ${countryCount} countries, each with its legal sources.` },
      { name: "Wikipedia", href: "https://en.wikipedia.org/wiki/List_of_drug_combinations", text: "Street names for combinations, so search finds the words people use (CC BY-SA)." },
    ],
  },
  {
    title: "Research",
    items: [
      { name: "Gable, Addiction (2004)", href: "https://doi.org/10.1111/j.1360-0443.2004.00744.x", text: "Lethal versus usual doses: the toxicity margin under each dose chart." },
      { name: "Nutt et al., The Lancet (2007)", href: "https://doi.org/10.1016/S0140-6736(07)60464-4", text: "Expert ratings behind the dependence meter." },
      { name: "Saferparty.ch, EFSA, UK CMOs, Widmark", text: "The MDMA, caffeine and alcohol limits behind the “For you” calculators." },
      { name: "EUDA, European Drug Report 2025", href: LINKS.euda, text: "The overdose figures on this page." },
    ],
  },
  {
    title: "Tools",
    items: [
      { name: "SmilesDrawer", href: "https://github.com/reymond-group/smilesDrawer", text: "Draws each molecule from its SMILES string." },
      { name: "Astro, SwiftUI and Jetpack Compose", text: "The web app and the native apps, built from one shared data pack." },
      { name: "three.js and WebGPU", text: "The holographic foils and the logo at the top of this page." },
    ],
  },
];

// Problem cards: real data from the combination chart and the card backs.
const riskyPairs = [
  ["mdma", "maois"],
  ["ketamine", "alcohol"],
  ["alcohol", "benzodiazepines"],
  ["cocaine", "alcohol"],
].map(([a, b]) => {
  const { definition } = getInteraction(a!, b!, locale);
  return { a: label(a!), b: label(b!), status: definition.statusKey, text: definition.label };
});
const emergencyRows = ["CH", "FR", "IT", "GB", "PL", "DE"].map((code) => ({
  code,
  number: getLocalInfo(code)?.emergency.number ?? "112",
}));

// Phase 01: the real combination matrix, one cell per pair.
const matrix = columns.map((row, i) =>
  columns.map((column, j) => {
    if (j > i) return null;
    if (j === i) return { kind: "self" as const, group: row.group };
    return { kind: "pair" as const, status: getInteraction(row.key, column.key, locale).definition.statusKey };
  })
);
const legend = [
  ["synergy", "Synergy"],
  ["safe", "Low risk"],
  ["decrease", "Decrease"],
  ["caution", "Caution"],
  ["unsafe", "Unsafe"],
  ["dangerous", "Dangerous"],
] as const;
const qr = await qrCodeSvg("https://psy.cards", 132);

const phases = [
  { id: "phase-web", n: "01", short: "Web" },
  { id: "phase-apps", n: "02", short: "Apps" },
  { id: "phase-social", n: "03", short: "Social" },
  { id: "phase-pilot", n: "04", short: "First print" },
  { id: "phase-scale", n: "05", short: "20,000 sets" },
  { id: "phase-festivals", n: "06", short: "Festivals" },
  { id: "europe", n: "07", short: "Europe" },
  { id: "psycare", n: "08", short: "PsyCare" },
];

const posts = [
  {
    handle: "en.psy.cards",
    language: "English",
    status: "Dangerous",
    title: "Never mix MDMA with MAOIs.",
    pair: ["MDMA", "MAOIs"],
    signs: "Watch for overheating, agitation and muscle twitching.",
    call: "In doubt? Call 112.",
  },
  {
    handle: "fr.psy.cards",
    language: "Français",
    status: "Dangereux",
    title: "Ne mélangez jamais MDMA et IMAO.",
    pair: ["MDMA", "IMAO"],
    signs: "Signes : surchauffe, agitation, contractions musculaires.",
    call: "En cas de doute, appelez le 112.",
  },
  {
    handle: "de.psy.cards",
    language: "Deutsch",
    status: "Gefährlich",
    title: "MDMA nie mit MAO-Hemmern mischen.",
    pair: ["MDMA", "MAO-Hemmer"],
    signs: "Achte auf Überhitzung, Unruhe und Muskelzucken.",
    call: "Im Zweifel 112 anrufen.",
  },
  {
    handle: "it.psy.cards",
    language: "Italiano",
    status: "Pericoloso",
    title: "Non mescolare mai MDMA e IMAO.",
    pair: ["MDMA", "IMAO"],
    signs: "Segnali: surriscaldamento, agitazione, spasmi muscolari.",
    call: "Nel dubbio, chiama il 112.",
  },
];

// Phase 05: one boxed edition per launch language.
const deckSpecs = [
  { code: "en", language: "English", tag: "Know your dose", hue: "var(--color-stimulant)" },
  { code: "fr", language: "Français", tag: "Connais ta dose", hue: "var(--color-empathogen)" },
  { code: "de", language: "Deutsch", tag: "Kenne deine Dosis", hue: "var(--color-psychedelic)" },
  { code: "it", language: "Italiano", tag: "Conosci la tua dose", hue: "var(--color-dissociative)" },
] as const;

const waves = [
  {
    label: "Today",
    title: "English, French, German, Italian",
    text: "The four launch languages, and the countries that speak them.",
  },
  {
    label: "Next",
    title: "Ten more EU languages",
    text: "Spanish, Portuguese, Dutch, Danish, Polish, Czech, Slovak, Slovenian, Croatian and Hungarian.",
  },
  {
    label: "Then",
    title: `All ${euLanguageCount} official EU languages`,
    text: "Swedish, Finnish, Estonian, Latvian, Lithuanian, Romanian, Bulgarian, Greek, Irish and Maltese.",
  },
  {
    label: "Beyond the EU",
    title: `Local help in ${countryCount} countries`,
    text: "Card backs already list emergency numbers, drug laws and services for every country on the map.",
  },
];
const waveCounts = EUROPE_WAVES.reduce<Array<{ countries: number; languages: number }>>((totals, wave, index) => {
  const previous = totals[index - 1] ?? { countries: 0, languages: 0 };
  totals.push({
    countries: previous.countries + wave.countries.length,
    languages: previous.languages + wave.languages.length,
  });
  return totals;
}, []);

---

<!doctype html>
<html lang={locale} data-color-scheme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={PWA_THEME_COLOR} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/appicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Unlisted: nothing links here, and search engines should not list it. -->
    <meta name="robots" content="noindex" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Cards start hidden off-screen only when the script can bring them in.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("lp-motion");
    </script>
    <script id="psy-i18n" type="application/json" set:html={i18nPayload}></script>
  </head>
  <body class="lp-body">
    <div class="lp-ambient" aria-hidden="true">
      <span class="lp-orb lp-orb--a"></span>
      <span class="lp-orb lp-orb--b"></span>
      <span class="lp-orb lp-orb--c"></span>
    </div>

    <a class="lp-skip" href="#why">Skip to content</a>

    <header class="lp-nav" data-lp-nav>
      <a class="lp-nav__brand" href="#top" aria-label="psy.cards — back to top">
        <img src="/favicon.png" alt="" width="30" height="30" />
        <Brand />
      </a>
      <nav class="lp-nav__links" aria-label="Sections">
        <a href="#why">Why</a>
        <a href="#cards">The cards</a>
        <a href="#roadmap">Roadmap</a>
        <a href="#psycare">PsyCare</a>
        <a href="#join">Get involved</a>
      </nav>
      <a class="lp-btn lp-btn--small lp-btn--light" href={LINKS.webApp}>
        Open the app
        <Icon name="ph:arrow-up-right-bold" aria-hidden="true" />
      </a>
    </header>

    <nav class="lp-rail" data-lp-rail aria-label="Roadmap phases">
      <span class="lp-rail__track"><span class="lp-rail__fill"></span></span>
      <ol>
        {
          phases.map((phase) => (
            <li>
              <a href={`#${phase.id}`} data-rail-link={phase.id}>
                <span class="lp-rail__n">{phase.n}</span>
                <span class="lp-rail__label">{phase.short}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <main class="lp" id="top">
      <!-- ───────────── Hero ───────────── -->
      <section class="lp-hero" data-lp-hero>
        <div class="lp-hero__copy">
          <p class="lp-pill lp-rise">
            <span class="lp-pill__dot"></span>
            Live on the web · free and open source
          </p>
          <h1 class="lp-hero__title lp-rise">
            Drug safety, on <span class="lp-holo-text">two sides of a card.</span>
          </h1>
          <p class="lp-hero__lead lp-rise">
            <Brand /> condenses verified harm-reduction data into A6 cards: dose and timing on the
            front, risks, interactions and local help on the back. The web version is live in four
            languages. Apps, social media and printed decks come next, then the rest of Europe.
          </p>
          <div class="lp-hero__actions lp-rise">
            <a class="lp-btn lp-btn--holo" href={LINKS.webApp}>
              Try the web version
              <Icon name="ph:arrow-right-bold" aria-hidden="true" />
            </a>
            <a class="lp-btn lp-btn--ghost" href="#roadmap">See the roadmap</a>
          </div>
          <dl class="lp-stats lp-rise">
            <div><dt>Substances</dt><dd>{substanceCount}</dd></div>
            <div><dt>Combinations</dt><dd>{comboCount}</dd></div>
            <div><dt>Languages</dt><dd>{languageCount}</dd></div>
            <div><dt>Countries</dt><dd>{countryCount}</dd></div>
          </dl>
        </div>

        <div class="lp-logo" data-hero-logo data-cards={JSON.stringify(logoCards)} aria-hidden="true">
          <canvas class="lp-logo__canvas"></canvas>
          <img class="lp-logo__fallback" src="/favicon.png" alt="" width="600" height="600" />
          <p class="lp-logo__word" data-hero-word>
            <span class="lp-logo__letters" data-letters>
              {letters.map((letter, i) => <span class:list={[letter === "." && "lp-brand__dot"]} style={`--i: ${i}`}>{letter}</span>)}
            </span>
            <span class="lp-logo__shine">PSY<span class="lp-brand__dot">.</span>{wordmarkTail}</span>
          </p>
        </div>

        <a class="lp-scroll-cue" href="#why" aria-label="Scroll to why psy.cards exists">
          <span></span>
        </a>
      </section>

      <!-- ───────────── Why ───────────── -->
      <section class="lp-section lp-why" id="why">
        <header class="lp-head lp-reveal">
          <p class="lp-eyebrow">The problem</p>
          <h2 class="lp-h2">The information exists. It rarely reaches people when they need it.</h2>
        </header>

        <div class="lp-why__stat lp-reveal">
          <p class="lp-why__number"><span data-count-to="7459">7,459</span></p>
          <div>
            <p class="lp-why__claim">
              overdose deaths involving drugs in the European Union in 2023, a minimum estimate. Most
              fatal overdoses involve more than one substance.
            </p>
            <p class="lp-cite">
              Source: <a href={LINKS.euda} target="_blank" rel="noreferrer noopener">EUDA, European Drug Report 2025</a>
            </p>
          </div>
        </div>

        <div class="lp-grid lp-grid--4">
          <HoloCard from="left" hue="var(--color-dangerous)" rest={-2} molecule="tramadol" backLabel="Combinations">
            <Face index="01" kicker="Combinations" spine="The problem · 1 of 4" foot="TripSit combination data">
              <p class="pc-big">1 + 1</p>
              <p class="pc-h">Combinations are the main risk</p>
              <p class="pc-text">Most fatal overdoses involve several substances, yet interaction data is hard to find quickly.</p>
              <ul class="pc-pairs">
                {riskyPairs.map((pair) => <li style={`--c: var(--color-${pair.status})`}><span>{pair.a} + {pair.b}</span><b>{pair.text}</b></li>)}
              </ul>
            </Face>
          </HoloCard>
          <HoloCard from="right" delay={0.1} hue="var(--color-dissociative)" rest={1.5} molecule="dmt" backLabel="Languages">
            <Face index="02" kicker="Languages" spine="The problem · 2 of 4" foot={`${liveLanguages.length} of ${euLanguageCount} covered today`}>
              <p class="pc-big">EN<small>/{euLanguageCount}</small></p>
              <p class="pc-h">Written mostly in English</p>
              <p class="pc-text">The best open harm-reduction databases are in English. The EU has {euLanguageCount} official languages.</p>
              <ul class="pc-langs">
                {euLanguages.map((code) => <li class:list={[liveLanguages.includes(code) && "is-live"]}>{code}</li>)}
              </ul>
            </Face>
          </HoloCard>
          <HoloCard from="left" delay={0.1} hue="var(--color-stimulant)" rest={-1.5} molecule="cocaine" backLabel="Borders">
            <Face index="03" kicker="Borders" spine="The problem · 3 of 4" foot={`Ambulance numbers · ${countryCount} countries mapped`}>
              <ul class="pc-numbers">
                {emergencyRows.map((row) => <li><span>{row.code}</span><b>{row.number}</b></li>)}
              </ul>
              <p class="pc-h">Rules change at every border</p>
              <p class="pc-text">Emergency numbers, laws and services differ by country, so generic advice often doesn't apply.</p>
            </Face>
          </HoloCard>
          <HoloCard from="right" delay={0.2} hue="var(--color-depressant)" rest={2} molecule="ghb-gbl" backLabel="Context">
            <Face index="04" kicker="Context" spine="The problem · 4 of 4" foot="Printed card + offline web app">
              <p class="pc-big">3 a.m.</p>
              <p class="pc-h">Decisions happen at night</p>
              <p class="pc-text">At festivals and clubs people are offline, on low battery or without a phone. Advice has to work on paper too.</p>
              <ul class="pc-conds">
                <li><Icon name="ph:wifi-slash-bold" aria-hidden="true" />No signal</li>
                <li><Icon name="ph:battery-warning-bold" aria-hidden="true" />5 % battery</li>
                <li><Icon name="ph:moon-stars-bold" aria-hidden="true" />Low light</li>
                <li><Icon name="ph:speaker-high-bold" aria-hidden="true" />Loud music</li>
              </ul>
            </Face>
          </HoloCard>
        </div>

        <div class="lp-mission lp-reveal">
          <p class="lp-eyebrow">The goal</p>
          <p class="lp-mission__quote">
            The same reliable harm&#8209;reduction information in every European country and
            language, <span class="lp-holo-text">and enough trained PsyCare responders to back it up.</span>
          </p>
          <ul class="lp-pillars">
            <li>
              <Icon name="ph:seal-check-fill" aria-hidden="true" />
              <h3>Verified</h3>
              <p>Built on TripSit and PsychonautWiki data, with every claim traceable to its source. Improvements go back upstream.</p>
            </li>
            <li>
              <Icon name="ph:map-pin-area-fill" aria-hidden="true" />
              <h3>Local</h3>
              <p>Card backs adapt to the country you're in: emergency numbers, drug laws and harm-reduction services for {countryCount} countries.</p>
            </li>
            <li>
              <Icon name="ph:cards-three-fill" aria-hidden="true" />
              <h3>One format</h3>
              <p>The same card in print, on the web, in the apps and on social media, so people find the same advice wherever they look.</p>
            </li>
            <li>
              <Icon name="ph:hand-heart-fill" aria-hidden="true" />
              <h3>PsyCare</h3>
              <p>Cards don't replace people. The long-term plan is a certified PsyCare network that events can call on.</p>
            </li>
          </ul>
        </div>

        <div class="lp-built">
          <div class="lp-built__intro lp-reveal">
            <p class="lp-eyebrow">Built on open knowledge</p>
            <h3 class="lp-h3">The work of others, condensed and credited</h3>
            <p>
              <Brand /> doesn't invent doses or risk ratings. It brings together what harm-reduction
              communities and researchers have published, cross-checks it, translates it and puts it in
              the same place on every card. Every claim links back to its source.
            </p>
            <figure class="lp-built__wheel">
              <DrugWheel locale={locale} />
              <figcaption>
                Seven categories, after <a href="https://www.thedrugswheel.com/" target="_blank" rel="noreferrer noopener">The Drugs Wheel</a>:
                each card takes the colour of its category, so a stimulant never looks like an opioid.
              </figcaption>
            </figure>
          </div>
          <div class="lp-built__lists">
            {
              builtOn.map((group) => (
                <section class="lp-built__group lp-reveal" aria-label={group.title}>
                  <h4>{group.title}</h4>
                  <ul>
                    {group.items.map((item) => (
                      <li>
                        <span class="lp-built__bullet" aria-hidden="true" />
                        <span>
                          {item.href ? (
                            <a href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noreferrer noopener" : undefined}>{item.name}</a>
                          ) : (
                            <b>{item.name}</b>
                          )}
                          <small>{item.text}</small>
                        </span>
                      </li>
                    ))}
                  </ul>
                </section>
              ))
            }
            <a class="lp-built__more" href={LINKS.sources} hreflang="en">
              Every source, revision and method
              <Icon name="ph:arrow-right-bold" aria-hidden="true" />
            </a>
          </div>
        </div>
      </section>

      <!-- ───────────── The cards ───────────── -->
      <section class="lp-section lp-anatomy" id="cards">
        <header class="lp-head lp-head--center lp-reveal">
          <p class="lp-eyebrow">The format</p>
          <h2 class="lp-h2">What's on a card</h2>
          <p class="lp-lead">
            Each card is A6, 105 × 148 mm, with the same layout on paper, on screen and in the apps.
            The front covers dose and timing; the back covers risks and what to do.
          </p>
        </header>

        <div class="lp-anatomy__grid">
          <ol class="lp-callouts lp-callouts--front">
            <li class="lp-reveal"><b>Dose by route</b><span>Light to heavy, with the toxicity margin underneath.</span></li>
            <li class="lp-reveal"><b>For you</b><span>Upper limits calculated from your weight and sex.</span></li>
            <li class="lp-reveal"><b>Effects over time</b><span>Come-up, peak and comedown, to help avoid redosing too early.</span></li>
            <li class="lp-reveal"><b>Spacing and testing</b><span>How long to wait between uses, and how to test what you have.</span></li>
          </ol>

          <div class="lp-anatomy__cards">
            <figure class="lp-anatomy__card">
              <HoloCard from="left" hue="var(--color-empathogen)" rest={-2} molecule="mdma" backLabel="Front" real>
                <SubstanceCard substanceKey="mdma" locale={locale} />
              </HoloCard>
              <figcaption>Front · dose and timing</figcaption>
            </figure>
            <figure class="lp-anatomy__card" data-show-back>
              <HoloCard from="right" delay={0.12} hue="var(--color-empathogen)" rest={2} molecule="mdma" backLabel="Back" real>
                <SubstanceCard substanceKey="mdma" locale={locale} />
              </HoloCard>
              <figcaption>Back · risks and safety</figcaption>
            </figure>
          </div>

          <ol class="lp-callouts lp-callouts--back">

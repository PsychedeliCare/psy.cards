---
import PrintLayout from "../../components/print/PrintLayout.astro";
import PrintCardPair from "../../components/print/PrintCardPair.astro";
import { getColumnBySlug } from "../../data/config";
import type { Locale } from "../../i18n/locales";
import { getUiMessages } from "../../i18n/load-locale";
import { t } from "../../i18n/ui";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

export const prerender = true;

export async function getStaticPaths() {
  const { getColumns } = await import("../../data/config");
  return getColumns("en").map((col) => ({ params: { slug: col.slug } }));
}

const { slug } = Astro.params;
if (!slug) return new Response("Not found", { status: 404 });

const col = getColumnBySlug(locale, slug);
if (!col) return new Response("Not found", { status: 404 });

const ui = getUiMessages(locale);
const siteOrigin = Astro.site?.href ?? "https://psy.cards";
---

<PrintLayout
  locale={locale}
  title={`${col.label} — ${t(locale, ui, "print.pageTitle")}`}
  mode="single"
>
  <PrintCardPair
    substanceKey={col.key}
    locale={locale}
    siteOrigin={siteOrigin}
  />
</PrintLayout>

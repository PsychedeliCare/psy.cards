---
import Icon from "./Icon.astro";
import { getColumns, sortPair } from "../data/config";
import { getInteraction } from "../data/combos";
import { getPrimaryComboSlang } from "../data/combo-slang";
import { pairSlug } from "../data/slug";
import type { StatusKey } from "../data/definitions";
import type { Locale } from "../i18n/locales";
import { localePath } from "../i18n/locales";
import { getUiMessages } from "../i18n/load-locale";
import { t } from "../i18n/ui";

interface Props {
  substanceKey: string;
  locale?: Locale;
}

const { substanceKey, locale = "en" } = Astro.props;
const ui = getUiMessages(locale);
const comboRoute = localePath(locale, "/combos");
const headingId = `substance-combos-${substanceKey.replace(/[^a-z0-9_-]+/gi, "-")}`;
const riskOrder: StatusKey[] = [
  "serotoninsyndrome", "dangerous", "unsafe", "caution",
  "synergy", "safe", "decrease", "unknown",
];
const rows = getColumns(locale)
  .filter((column) => column.key !== substanceKey)
  .map((column) => {
    const { definition } = getInteraction(substanceKey, column.key, locale);
    const [a, b] = sortPair(locale, substanceKey, column.key);
    const slug = pairSlug(a, b);
    return {
      label: column.label,
      slug,
      href: `${comboRoute}?combo=${slug}`,
      definition,
      slang: getPrimaryComboSlang(substanceKey, column.key),
    };
  });
const groups = riskOrder.flatMap((status) => {
  const substances = rows.filter((row) => row.definition.statusKey === status);
  return substances.length ? [{ definition: substances[0]!.definition, substances }] : [];
});
---

{groups.length > 0 && (
  <section class="substance-combos" aria-labelledby={headingId}>
    <h3 id={headingId}>{t(locale, ui, "substanceCard.combos")}</h3>
    <dl class="substance-combos-list">
      {groups.map(({ definition, substances }) => (
        <div class={`substance-combos-risk-row status-${definition.statusKey}`}>
          <dt>
            <span class="substance-combos-risk-icon" aria-hidden="true">
              <Icon name={definition.icon} size="1em" />
            </span>
            <span>{definition.statusKey === "unknown" ? t(locale, ui, "status.unknown") : definition.label}</span>
          </dt>
          <dd>
            {substances.map((row, index) => (
              <><a href={row.href} data-combo={row.slug} title={row.slang}>
                {row.label}
              </a>{index < substances.length - 1 ? ", " : ""}</>
            ))}
          </dd>
        </div>
      ))}
    </dl>
  </section>
)}

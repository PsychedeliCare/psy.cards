---
import "../../styles/global.css";
import "../../styles/print.css";
import type { Locale } from "../../i18n/locales";

interface Props {
  locale?: Locale;
  title: string;
  mode?: "single" | "batch";
  bodyClass?: string;
}

const {
  locale = "en",
  title,
  mode = "single",
  bodyClass = "",
} = Astro.props;
---

<!doctype html>
<html lang={locale} data-color-scheme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
  </head>
  <body class:list={["print-root", `print-output`, `print-output--${mode}`, bodyClass]}>
    <slot />
    <script>
      import { initSmilesDrawer } from "../../scripts/smiles-drawer.ts";
      initSmilesDrawer();
      document.documentElement.dataset.printReady = "true";
    </script>
  </body>
</html>

---
/**
 * Persistent circular "thumb jog dial" substance navigator.
 *
 * The full SVG (wedges, labels, hub, rim) is server-rendered so the dial is
 * visible and correct — a static ring of substance links — with JS disabled.
 * `src/scripts/substance-dial.ts` only adds rotation and interaction.
 *
 * Full disc at every screen size, with the selection marker at 90° (east).
 */
import "../styles/dial.css";
import type { Locale } from "../i18n/locales";
import { localePath } from "../i18n/locales";
import { getUiMessages } from "../i18n/load-locale";
import { t } from "../i18n/ui";
import {
  DESKTOP_DETENT,
  DIAL,
  buildDialLayout,
  labelReverseOpacity,
  rotationForSubstance,
  substanceLabelOrientation,
  type DialCategoryInput,
} from "../lib/dial-geometry";

interface Props {
  locale?: Locale;
  categories: DialCategoryInput[];
  /** Substance sitting under the detent on first paint. */
  initialKey: string;
}

const { locale = "en", categories, initialKey } = Astro.props;
const ui = getUiMessages(locale);

const layout = buildDialLayout(categories.map((cat) => ({
  ...cat,
  label: cat.label.toLocaleUpperCase(locale),
})));
const initialSub =
  layout.substances.find((s) => s.key === initialKey) ?? layout.substances[0]!;
const activeGroup = initialSub.group;

// The east-facing marker stays in the same position on every screen size.
const initialRotation = rotationForSubstance(initialSub.midAngle, DESKTOP_DETENT, 0);

const uid = `dial-${Math.random().toString(36).slice(2, 8)}`;
const optionId = (slug: string) => `${uid}-opt-${slug}`;

const ariaLabel = t(locale, ui, "dial.ariaLabel");
const substanceBase = localePath(locale, "/");
---

<div
  class="dial-shell"
  data-dial-shell
  data-uid={uid}
>
  <div
    class="dial-disc"
    data-dial-disc
    tabindex="0"
    role="listbox"
    aria-label={ariaLabel}
    aria-activedescendant={optionId(initialSub.slug)}
    aria-controls="wheel-substance"
  >
    <svg
      viewBox="-100 -100 200 200"
      data-dial-svg
      xmlns="http://www.w3.org/2000/svg"
    >
      <g data-dial-rotor data-initial-rotation={initialRotation} transform={`rotate(${initialRotation})`}>
        {
          layout.categories.map((cat, i) => {
            const reverseOpacity = labelReverseOpacity(cat.midAngle, initialRotation, "category");
            const arcId = `${uid}-cat-${i}`;
            return (
              <g
                class={`dial-category group-${cat.group}`}
                data-dial-category
                data-group={cat.group}
                data-mid-angle={cat.midAngle}
                data-active={cat.group === activeGroup ? "true" : "false"}
                role="group"
                aria-label={cat.label}
              >
                <path class="dial-category-wedge" d={cat.path} />
                <defs>
                  <path
                    id={`${arcId}-forward`}
                    d={cat.labelArcForward}
                    data-dial-cat-arc
                  />
                  <path id={`${arcId}-reverse`} d={cat.labelArcReverse} />
                </defs>
                {[false, true].map((reversed) => (
                  <text
                    class="dial-category-label"
                    data-dial-label={reversed ? "reverse" : "forward"}
                    font-size={cat.labelFontSize.toFixed(2)}
                    opacity={reversed ? reverseOpacity : 1 - reverseOpacity}
                    aria-hidden="true"
                  >
                    <textPath href={`#${arcId}-${reversed ? "reverse" : "forward"}`} startOffset="50%">
                      {cat.label}
                    </textPath>
                  </text>
                ))}
              </g>
            );
          })
        }
        {
          layout.substances.map((sub) => {
            const reverseOpacity = labelReverseOpacity(sub.midAngle, initialRotation, "substance");
            const isActive = sub.key === initialSub.key;
            return (
              <a
                href={`${substanceBase}${sub.slug}`}
                id={optionId(sub.slug)}
                class={`dial-substance group-${sub.group}`}
                role="option"
                aria-label={sub.label}
                aria-selected={isActive ? "true" : "false"}
                data-dial-substance
                data-key={sub.key}
                data-slug={sub.slug}
                data-label={sub.label}
                data-group={sub.group}
                data-mid-angle={sub.midAngle}
                data-active={isActive ? "true" : "false"}
                data-in-active-group={sub.group === activeGroup ? "true" : "false"}
              >
                <path class="dial-substance-wedge" data-dial-wedge d={sub.path} />
                {[false, true].map((reversed) => {
                  const o = substanceLabelOrientation(sub.midAngle, reversed);
                  return (
                    <text
                      class="dial-substance-label"
                      data-dial-label={reversed ? "reverse" : "forward"}
                      transform={o.transform}
                      text-anchor={o.anchor}
                      font-size={sub.fontSize.toFixed(2)}
                      opacity={reversed ? reverseOpacity : 1 - reverseOpacity}
                      aria-hidden="true"
                    >
                      {sub.label}
                    </text>
                  );
                })}
              </a>
            );
          })
        }
      </g>
      <circle class="dial-hub" r={DIAL.hubRadius} />
      <text class="dial-hub-label" text-anchor="middle" y="1.5" aria-hidden="true">PSY.CARDS</text>
      <circle class="dial-rim" r={DIAL.rimRadius} />
      <circle class="dial-focus-ring" r={DIAL.rimRadius - 5} />
    </svg>
  </div>
  <div class="dial-marker" aria-hidden="true"></div>
  <div class="sr-only" aria-live="polite" data-dial-live></div>
</div>

      <!-- ───────────── 08 · PsyCare ───────────── -->
      <section class="lp-section lp-psycare" id="psycare" style="--hue: var(--color-opioid)">
        <header class="lp-head lp-head--center lp-reveal">
          <p class="lp-phase__meta lp-phase__meta--center"><span class="lp-phase__n">Phase 08</span><span class="lp-status">Target · Q4 2027</span></p>
          <h2 class="lp-h2">PsyCare at scale</h2>
          <p class="lp-lead">
            PsyCare teams support people through difficult psychedelic experiences at events. There
            aren't enough trained teams to cover every event, so this phase trains more people and gets
            them where they're needed, with local harm-reduction organisations as partners. The target
            is a first certified network by the fourth quarter of 2027.
          </p>
        </header>

        <div class="lp-psycare__row">
          <div class="lp-psycare__copy lp-reveal">
            <p class="lp-eyebrow">Training and certification</p>
            <h3 class="lp-h3">Open training, recognised certification</h3>
            <p>
              A curriculum built on the cards and taught with the local organisations that already run
              PsyCare and welfare teams: set and setting, de-escalation, creating a safe space and knowing
              when to hand over to medical staff. Peers and professionals earn a certificate that
              festivals and partners across Europe can check.
            </p>
            <ul class="lp-facts">
              <li><Icon name="ph:handshake-bold" aria-hidden="true" />With local harm-reduction organisations</li>
              <li><Icon name="ph:certificate-bold" aria-hidden="true" />Certificate anyone can verify</li>
            </ul>
          </div>
          <div class="lp-psycare__visual lp-devices lp-devices--single">
            <figure class="lp-device">
              <Device kind="iphone" from="right" rest={2} label="A PsyCare responder's certificate in the app: level 2 peer supporter, languages, validity and a QR code, above the progress of each training module.">
                <PsyCareScreen view="certificate" qr={qr} />
              </Device>
            </figure>
          </div>
        </div>

        <div class="lp-psycare__row lp-psycare__row--flip">
          <div class="lp-psycare__copy lp-reveal">
            <p class="lp-eyebrow">The alert network</p>
            <h3 class="lp-h3">An alert network for PsyCare emergencies</h3>
            <p>
              Qualified therapists and experienced peers sign up and set when they're available. When
              first-responder staff at an event trigger a PsyCare emergency, the nearest certified
              responders get an alert and can accept it in one tap.
            </p>
            <p class="lp-note">
              <Icon name="ph:shield-check-fill" aria-hidden="true" />
              Responders are verified. Alerts contain a location and a need, never the identity of the
              person in crisis.
            </p>
          </div>
          <div class="lp-psycare__visual lp-devices lp-devices--pair">
            <figure class="lp-device">
              <Device kind="iphone" from="left" rest={-3} time="" label="A PsyCare alert on the lock screen over the festival map: PsyCare needed at the medical tent by Stage B, 350 metres away, with Accept and Not now.">
                <PsyCareScreen view="alert" />
              </Device>
            </figure>
            <figure class="lp-device lp-device--raised">
              <Device kind="android" from="bottom" delay={0.15} rest={3} time="02:16" label="A responder's availability on Android: available now within 2 km, a week of availability and alert settings.">
                <PsyCareScreen view="availability" />
              </Device>
            </figure>
          </div>
        </div>

        <ol class="lp-devices lp-flow">
          <li class="lp-device">
            <Device kind="iphone" from="bottom" time="2:09" label="Staff request PsyCare: the medical tent at Stage B, an anxious but conscious guest, English, soon.">
              <PsyCareScreen view="request" />
            </Device>
            <p class="lp-flow__step lp-reveal"><span>1</span><b>Staff request PsyCare</b>First-aid or awareness staff send a location and a short description of the need.</p>
          </li>
          <li class="lp-device">
            <Device kind="iphone" from="bottom" delay={0.12} time="2:10" label="Finding help: certified responders nearby who speak English are notified; one is busy.">
              <PsyCareScreen view="match" />
            </Device>
            <p class="lp-flow__step lp-reveal"><span>2</span><b>Responders nearby get an alert</b>Only certified responders who are available, close by and speak the right language.</p>
          </li>
          <li class="lp-device">
            <Device kind="iphone" from="bottom" delay={0.24} time="2:14" label="Accepted: a responder arrives in about four minutes, with the meeting point and a short briefing.">
              <PsyCareScreen view="briefing" />
            </Device>
            <p class="lp-flow__step lp-reveal"><span>3</span><b>One accepts and goes</b>The first to accept gets the meeting point and a briefing; the others are released.</p>
          </li>
        </ol>
      </section>

      <!-- ───────────── Get involved ───────────── -->

---
import {
  getGroupLabels,
  visibleGroupOrder,
  type GroupName,
} from "../data/config";
import type { Locale } from "../i18n/locales";
import { getUiMessages } from "../i18n/load-locale";
import { t } from "../i18n/ui";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const ui = getUiMessages(locale);
const groupLabels = getGroupLabels(locale);

const tabs: Array<{ id: "all" | GroupName; label: string }> = [
  { id: "all", label: t(locale, ui, "landing.tabAll") },
  ...visibleGroupOrder.map((group) => ({
    id: group,
    label: groupLabels[group],
  })),
];
---

<nav
  class="landing-nav"
  data-landing-nav
  aria-label={t(locale, ui, "landing.categoriesAria")}
>
  <div class="landing-tabs" role="tablist" aria-label={t(locale, ui, "landing.categoriesAria")}>
    <button
      type="button"
      class="landing-search"
      data-search-trigger
      aria-label={t(locale, ui, "comboTable.searchAriaLabel")}
      title={t(locale, ui, "comboTable.searchTitle")}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M10.75 4a6.75 6.75 0 1 0 4.16 12.06l3.52 3.51 1.41-1.41-3.51-3.52A6.75 6.75 0 0 0 10.75 4Zm0 2a4.75 4.75 0 1 1 0 9.5 4.75 4.75 0 0 1 0-9.5Z"
        ></path>
      </svg>
    </button>
    {
      tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          class:list={[
            "landing-tab",
            tab.id !== "all" && `group-${tab.id}`,
            index === 0 && "is-active",
          ]}
          data-tab={tab.id}
          aria-selected={index === 0 ? "true" : "false"}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          <span class="landing-tab-label">{tab.label}</span>
        </button>
      ))
    }
  </div>
</nav>

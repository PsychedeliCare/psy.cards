{
	// Cloudflare Workers Builds runs `npx wrangler deploy` from the repo root.
	// Wrangler 4.131+ refuses workspace-root autodetection, so this file must
	// live here. Keep it aligned with packages/web/wrangler.jsonc.
	"compatibility_date": "2026-04-23",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "psy-cards",
	// Pin the account that already hosts psy.cards. Local Wrangler profiles
	// default to other accounts and must not create this Worker elsewhere.
	"account_id": "c937f1b41fd854e31731dac9ab9874a0",
	"main": "packages/web/src/worker.js",
	// Keep versioned preview URLs enabled on workers.dev (required when workers.dev route is off).
	"preview_urls": true,
	"routes": [
		{
			"pattern": "psy.cards",
			"custom_domain": true
		},
		{
			"pattern": "www.psy.cards",
			"custom_domain": true
		},
		{
			"pattern": "burning-mountain.psy.cards",
			"custom_domain": true
		},
		{
			"pattern": "bm.psy.cards",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./packages/web/dist",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	},
	// Separate Worker `psy-cards-dev`. Its Workers Builds production branch
	// should be `develop`, with deploy command `npx wrangler deploy --env dev`.
	// Routes here replace the inherited production domains.
	"env": {
		"dev": {
			"workers_dev": false,
			"routes": [
				{
					"pattern": "dev.psy.cards",
					"custom_domain": true
				}
			]
		}
	}
}

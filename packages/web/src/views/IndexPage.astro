---
import Layout from "../components/Layout.astro";
import Footer from "../components/Footer.astro";
import LandingNav from "../components/LandingNav.astro";
import BrowseViewSwitcher from "../components/BrowseViewSwitcher.astro";
import SubstanceListCard from "../components/SubstanceListCard.astro";
import SubstanceCard from "../components/SubstanceCard.astro";
import type { Locale } from "../i18n/locales";
import { getUiMessages } from "../i18n/load-locale";
import { t } from "../i18n/ui";
import { localePath } from "../i18n/locales";
import { getColumns, visibleGroupOrder } from "../data/config";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const ui = getUiMessages(locale);
const visibleGroups = new Set(visibleGroupOrder);
const columns = getColumns(locale).filter((column) =>
  visibleGroups.has(column.group)
);
const initial = columns[0]!;
const homeRoute = localePath(locale, "/");
---

<Layout
  locale={locale}
  title={t(locale, ui, "meta.siteTitle")}
  description={t(locale, ui, "meta.landingDescription")}
  headerView="list"
>
  <main class="landing browse-page">
    <div class="browse-layout">
      <aside class="browse-explorer">
        <div class="browse-chrome">
          <BrowseViewSwitcher locale={locale} active="list" />
          <LandingNav locale={locale} />
        </div>

        <ul class="substance-list" data-substance-list>
          {columns.map((column) => (
            <SubstanceListCard
              column={column}
              locale={locale}
              selected={column.key === initial.key}
            />
          ))}
        </ul>
      </aside>

      <div class="browse-reading">
        <div class="browse-card-status" data-list-status role="status" hidden>
          <span data-list-status-text></span>
          <button type="button" data-list-retry hidden>{t(locale, ui, "dial.retry")}</button>
        </div>
        <div class="browse-card" data-list-detail data-initial-slug={initial.slug}>
          <SubstanceCard substanceKey={initial.key} locale={locale} />
        </div>
      </div>
    </div>
  </main>

  <Footer locale={locale} variant="narrow" />

  <div id="modal-slot" data-modal-slot data-landing-root={homeRoute}></div>

  <script>
    import { initLandingCards, initBrowseSwitch } from "../scripts/landing-cards.ts";
    import { initComboModal } from "../scripts/combo-modal.ts";
    import { initSearchPalette } from "../scripts/search-palette.ts";

    initBrowseSwitch();
    initLandingCards();
    initSearchPalette();
    const root =
      document
        .querySelector<HTMLElement>("[data-modal-slot]")
        ?.dataset.landingRoot ?? "/";
    initComboModal({ rootRoute: root });
  </script>
</Layout>

<style>
  .landing {
    margin: 0 auto;
    padding: 16px 20px 96px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  @media (min-width: 821px) {
    .landing {
      padding-inline: clamp(12px, 3vw, 48px);
    }
  }
</style>

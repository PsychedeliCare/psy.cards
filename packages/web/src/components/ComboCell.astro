---
import Icon from "./Icon.astro";
import { getInteraction } from "../data/combos";
import { pairSlug } from "../data/slug";
import { sortPair } from "../data/config";
import type { Locale } from "../i18n/locales";
import { getUiMessages } from "../i18n/load-locale";
import { t } from "../i18n/ui";

interface Props {
  rowKey: string;
  colKey: string;
  rowLabel: string;
  colLabel: string;
  comboRoute?: string;
  locale?: Locale;
}

const {
  rowKey,
  colKey,
  rowLabel,
  colLabel,
  comboRoute = "/combos",
  locale = "en",
} = Astro.props;

const ui = getUiMessages(locale);
const { definition, note, sources } = getInteraction(rowKey, colKey, locale);
const [aKey, bKey] = sortPair(locale, rowKey, colKey);
const slug = pairSlug(aKey, bKey);
const href = `${comboRoute}?combo=${slug}`;
const sourceCount = sources?.length ?? 0;
const metadataLabels = [
  note ? t(locale, ui, "comboCard.noteOnPair") : null,
  sourceCount > 0 ? `${t(locale, ui, "comboCard.sources")}: ${sourceCount}` : null,
].filter((label): label is string => Boolean(label));
const ariaLabel = [
  `${rowLabel} + ${colLabel}: ${definition.label}`,
  ...metadataLabels,
].join(" — ");
const tooltipTitle = `${rowLabel} + ${colLabel} = ${definition.label}`;
---

<div
  class={`combo-cell status-${definition.statusKey} cell-text`}
  data-combo-tooltip
  data-has-note={String(Boolean(note))}
  data-has-sources={String(sourceCount > 0)}
  data-tooltip-key={slug}
  data-tooltip-title={tooltipTitle}
  data-tooltip-status={definition.statusKey}
>
  <a
    href={href}
    class="combo-cell__hit-area"
    data-combo={slug}
    data-row={rowKey}
    data-col={colKey}
    aria-label={ariaLabel}
  >
    <Icon
      name={definition.icon}
      size="1.72em"
      class="combo-cell__icon"
    />
  </a>
</div>

<style>
  .combo-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 100%;
    height: 100%;
    min-height: var(--table-cell-height, 52px);
    box-sizing: border-box;
    border: clamp(2px, calc(var(--table-cell-height, 56px) * 0.04), 3px) solid
      color-mix(in oklab, var(--hue, var(--color-unknown)), transparent 42%);
    background: transparent;
    transition:
      border-color 120ms ease,
      filter 120ms ease;
  }

  .combo-cell__hit-area {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  :global(.combo-cell__icon) {
    flex: 0 0 auto;
    color: var(--hue, var(--color-unknown));
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.28));
    transition: transform 120ms ease;
  }

  .combo-cell:hover {
    border-color: color-mix(in oklab, var(--hue, var(--color-unknown)), transparent 18%);
    filter: brightness(1.18) saturate(1.1);
  }

  .combo-cell:hover :global(.combo-cell__icon) {
    transform: scale(1.08);
  }

  .combo-cell:focus-within {
    outline: 2px solid color-mix(in oklab, var(--hue-ink, #fff), transparent 8%);
    outline-offset: -5px;
    border-color: color-mix(in oklab, var(--hue, var(--color-unknown)), var(--hue-ink, white) 18%);
    filter: brightness(1.18);
  }

  .combo-cell:focus-within :global(.combo-cell__icon) {
    transform: scale(1.08);
  }

  .combo-cell__hit-area:focus-visible {
    outline: none;
  }
</style>

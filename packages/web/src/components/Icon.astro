---
import type { IconName } from "../data/definitions";
import { statusIcons } from "../data/status-icons";

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  title?: string;
}

const { name, size = "1em", class: className = "", title } = Astro.props;
const icon = statusIcons[name];
---

<svg
  viewBox="0 0 256 256"
  width={size}
  height={size}
  class={className}
  aria-hidden={title ? undefined : "true"}
  role={title ? "img" : undefined}
  fill="currentColor"
>
  {title && <title>{title}</title>}
  <path d={icon.secondary} opacity="0.28" />
  <path d={icon.primary} />
</svg>

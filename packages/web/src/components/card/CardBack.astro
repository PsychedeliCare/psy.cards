---
import { Icon } from "@twodft/astro-icon/components";
import StatusIcon from "../Icon.astro";
import MoleculeFigure from "../MoleculeFigure.astro";
import { keyToSlug } from "../../data/slug";
import type { CardData } from "../../data/harm-reduction";
import type { Locale } from "../../i18n/locales";
import { getUiMessages } from "../../i18n/load-locale";
import { t, tFormat } from "../../i18n/ui";

interface Props {
  data: CardData;
  locale: Locale;
  uid: string;
  displayName: string;
  hasStructure: boolean;
}

const { data, locale, uid, displayName, hasStructure } = Astro.props;
const ui = getUiMessages(locale);
const c = data.content;
const spacing = c.spacing;
const pattern = data.spacing.pattern ? [...data.spacing.pattern] : [];
const spanUnit = data.spacing.unit ? t(locale, ui, `card.units.${data.spacing.unit}`) : "";
const level = Math.min(5, Math.max(1, data.dependence.level));
const levelLabel = t(locale, ui, `card.dependenceLevels.${level}`);
const dependencePopover = `${uid}-dependence`;
const emergencyNumber = t(locale, ui, "card.emergencyNumber");
// Two rows of chips at most; the full list lives in the details below.
const MAX_AVOID = 7;
const shownAvoid = data.avoid.length > MAX_AVOID + 1 ? data.avoid.slice(0, MAX_AVOID) : data.avoid;
const hiddenAvoid = data.avoid.length - shownAvoid.length;
const MAX_CAUTION = 6;
const shownCaution = data.caution.slice(0, data.caution.length > MAX_CAUTION + 1 ? MAX_CAUTION : undefined);
const hiddenCaution = data.caution.length - shownCaution.length;
const combosHeadingId = `substance-combos-${data.key.replace(/[^a-z0-9_-]+/gi, "-")}`;
---

<section class="psy-face psy-face--back" id={`${uid}-back`} aria-labelledby={`${uid}-back-title`} data-hologram-host>
  <span class="psy-foil" aria-hidden="true"></span>
  {hasStructure && (
    <canvas
      class="substance-hologram"
      data-molecule-mask={`/assets/molecules/${keyToSlug(data.key)}.png`}
      data-hologram-tone="silver"
      aria-hidden="true"
    />
  )}
  <MoleculeFigure substanceKey={data.key} />
  <header class="psy-head psy-head--back">
    <div>
      <p class="psy-head__kicker">{displayName}</p>
      <h2 class="psy-head__title psy-head__title--back" id={`${uid}-back-title`}>{t(locale, ui, "card.flipToSafety")}</h2>
    </div>
    <label class="psy-flip psy-flip--icon" for={`${uid}-side-front`} title={t(locale, ui, "card.flipToDose")}>
      <Icon name="ph:arrows-counter-clockwise-bold" aria-hidden="true" />
      <span>{t(locale, ui, "card.faceDose")}</span>
    </label>
  </header>

  <div class="psy-bento">
    <div class="psy-row psy-row--back">
      {spacing && (
        <section class="psy-tile psy-tile--spacing" aria-labelledby={`${uid}-spacing`}>
          <h3 id={`${uid}-spacing`}>
            <Icon name="ph:calendar-dots-fill" aria-hidden="true" />
            {t(locale, ui, "card.spacing")}
          </h3>
          <p class="psy-spacing__value">
            <strong>{spacing.value}</strong>
            <span>{spacing.label}</span>
          </p>
          {pattern.length > 0 && (
            <div class="psy-spacing__pattern" aria-hidden="true">
              <span class="psy-spacing__cells">
                {pattern.map((cell) => <span class:list={["psy-spacing__cell", { "is-use": cell === "x" }]} />)}
              </span>
              <span class="psy-spacing__span">{tFormat(locale, ui, "card.spacingSpan", { count: String(pattern.length), unit: spanUnit })}</span>
            </div>
          )}
          <p class="psy-tile__text">{spacing.text}</p>
        </section>
      )}
      <section class="psy-tile psy-tile--dependence" aria-labelledby={`${uid}-dependence`}>
        <div class="psy-tile__head">
          <h3 id={`${uid}-dependence`}>
            <Icon name="ph:link-break-fill" aria-hidden="true" />
            {t(locale, ui, "card.dependence")}
          </h3>
          <button type="button" class="psy-info-btn" popovertarget={dependencePopover} aria-label={t(locale, ui, "card.info")}>
            <Icon name="ph:info-bold" aria-hidden="true" />
          </button>
        </div>
        <div class="psy-meter" data-level={level} role="meter" aria-valuemin="1" aria-valuemax="5" aria-valuenow={level} aria-valuetext={levelLabel} aria-labelledby={`${uid}-dependence`}>
          {[1, 2, 3, 4, 5].map((step) => <span class:list={["psy-meter__step", { "is-on": step <= level }]} />)}
        </div>
        <p class="psy-meter__label">{levelLabel}</p>
        {c.dependence && <p class="psy-tile__text psy-tile__text--small">{c.dependence}</p>}
      </section>
    </div>

    {c.risks && c.risks.length > 0 && (
      <section class="psy-tile psy-tile--risks" aria-labelledby={`${uid}-risks`}>
        <h3 id={`${uid}-risks`}>
          <Icon name="ph:warning-fill" aria-hidden="true" />
          {t(locale, ui, "card.risks")}
        </h3>
        <ul class="psy-risks">
          {c.risks.map((risk) => (
            <li>
              <span class="psy-risks__icon"><Icon name={`ph:${risk.icon}`} aria-hidden="true" /></span>
              <p><strong>{risk.title}.</strong> {risk.text}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="psy-tile psy-tile--avoid" aria-labelledby={`${uid}-avoid`}>
      <h3 id={`${uid}-avoid`}>
        <Icon name="ph:prohibit-fill" aria-hidden="true" />
        {t(locale, ui, "card.avoid")}
      </h3>
      {data.avoid.length > 0 ? (
        <ul class="psy-avoid">
          {shownAvoid.map((combo) => (
            <li class={`status-${combo.statusKey}`}>
              <a href={combo.href} data-combo={combo.slug} class="psy-avoid__chip status-surface cell-text" title={combo.statusLabel}>
                <StatusIcon name={combo.icon} size="1.05em" />
                {combo.label}
              </a>
            </li>
          ))}
          {hiddenAvoid > 0 && (
            <li>
              <a href={`#${combosHeadingId}`} class="psy-avoid__chip psy-avoid__more" data-scroll-to-combos>
                {tFormat(locale, ui, "card.otherRoutesCount", { count: String(hiddenAvoid) })}
              </a>
            </li>
          )}
        </ul>
      ) : (
        <p class="psy-tile__text">{t(locale, ui, "card.avoidNone")}</p>
      )}
      {data.caution.length > 0 && (
        <p class="psy-tile__text psy-tile__text--small psy-caution">
          <strong>{t(locale, ui, "card.caution")}:</strong>{" "}
          {shownCaution.map((combo, index) => (
            <><a href={combo.href} data-combo={combo.slug}>{combo.label}</a>{index < shownCaution.length - 1 ? ", " : ""}</>
          ))}
          {hiddenCaution > 0 && (
            <>{" "}<a href={`#${combosHeadingId}`} data-scroll-to-combos>+{hiddenCaution}</a></>
          )}
        </p>
      )}
    </section>

    {c.overdose && (
      <section class="psy-tile psy-tile--emergency" aria-labelledby={`${uid}-emergency`}>
        <div class="psy-tile__head">
          <h3 id={`${uid}-emergency`}>
            <Icon name="ph:siren-fill" aria-hidden="true" />
            {t(locale, ui, "card.emergency")}
          </h3>
          <a class="psy-call" href={`tel:${emergencyNumber}`}>
            <Icon name="ph:phone-call-fill" aria-hidden="true" />
            {tFormat(locale, ui, "card.call", { number: emergencyNumber })}
          </a>
        </div>
        <p class="psy-tile__text psy-emergency__signs">
          <strong>{t(locale, ui, "card.signs")}:</strong> {c.overdose.signs.join(" · ")}
        </p>
        <ol class="psy-emergency__actions" aria-label={t(locale, ui, "card.actions")}>
          {c.overdose.actions.map((action) => <li>{action}</li>)}
        </ol>
      </section>
    )}
  </div>

  <span class="psy-curl" aria-hidden="true"></span>
</section>

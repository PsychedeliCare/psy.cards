---
/**
 * Internal review page: proposed additions to the cards, and the legality
 * entries that most need a human check. English only, not indexed.
 */
import Layout from "../components/Layout.astro";
import Footer from "../components/Footer.astro";
import { improvementGroups, type Impact } from "../data/improvements";
import { countryFlag, getLocalInfo, listLocalInfoCountries } from "../data/local-info";
import { getColumns } from "../data/config";

export const prerender = true;

const impactLabels: Record<Impact, string> = { critical: "Life-saving", high: "High impact", medium: "Useful" };
const statusLabels = { proposed: "Proposed", started: "Started", done: "Done" } as const;
const effortLabels = { S: "Small", M: "Medium", L: "Large" } as const;
const labels = Object.fromEntries(getColumns("en").map((column) => [column.key, column.label]));
const all = improvementGroups.flatMap((group) => group.items);
const counts = {
  critical: all.filter((item) => item.impact === "critical").length,
  high: all.filter((item) => item.impact === "high").length,
  medium: all.filter((item) => item.impact === "medium").length,
};

// Legality entries to review first: unknown status or low confidence.
const names = new Intl.DisplayNames(["en"], { type: "region" });
const review = listLocalInfoCountries()
  .filter((code) => code !== "ZZ")
  .map((code) => {
    const info = getLocalInfo(code)!;
    const entries = Object.entries(info.substances).filter(
      ([, entry]) => entry.status === "unknown" || entry.confidence === "low"
    );
    const medium = Object.values(info.substances).filter((entry) => entry.confidence === "medium").length;
    let name = info.name;
    try {
      const display = names.of(code);
      if (display && display !== code) name = display;
    } catch {
      // Keep the file's name.
    }
    return { code, name, entries, medium, total: Object.keys(info.substances).length };
  })
  .sort((a, b) => b.entries.length - a.entries.length || a.name.localeCompare(b.name));
const reviewTotal = review.reduce((sum, country) => sum + country.entries.length, 0);
---

<Layout
  locale="en"
  title="Improvements — psy.cards"
  description="Proposed additions to the psy.cards harm reduction cards, for review."
  showLanguageSwitcher={false}
  noindex
>
  <main class="improvements">
    <header class="hero">
      <p class="eyebrow">Internal · for review</p>
      <h1>What else should the cards say?</h1>
      <p class="lede">
        Ideas collected while reworking the cards: what would make them more useful, more
        accurate and better at keeping people alive. Each item says why it matters, what to
        build and where it would live.
      </p>
      <ul class="summary" aria-label="Summary">
        <li class="impact-critical"><strong>{counts.critical}</strong> life-saving</li>
        <li class="impact-high"><strong>{counts.high}</strong> high impact</li>
        <li class="impact-medium"><strong>{counts.medium}</strong> useful</li>
        <li><strong>{reviewTotal}</strong> legal entries to check</li>
      </ul>
      <div class="filters" role="group" aria-label="Filter by impact" data-filters>
        <button type="button" aria-pressed="true" data-filter="all">All</button>
        <button type="button" aria-pressed="false" data-filter="critical">Life-saving</button>
        <button type="button" aria-pressed="false" data-filter="high">High impact</button>
        <button type="button" aria-pressed="false" data-filter="medium">Useful</button>
      </div>
      <nav class="toc" aria-label="On this page">
        {improvementGroups.map((group) => <a href={`#${group.id}`}>{group.title.split(":")[0]}</a>)}
        <a href="#legal-review">Legal data review</a>
      </nav>
    </header>

    {improvementGroups.map((group) => (
      <section class="group" id={group.id} aria-labelledby={`${group.id}-title`}>
        <div class="group__head">
          <h2 id={`${group.id}-title`}>{group.title}</h2>
          <p>{group.intro}</p>
        </div>
        <ol class="items">
          {group.items.map((item) => (
            <li class={`item impact-${item.impact}`} id={item.id} data-impact={item.impact}>
              <div class="item__meta">
                <span class="badge badge--impact">{impactLabels[item.impact]}</span>
                <span class={`badge badge--status is-${item.status}`}>{statusLabels[item.status]}</span>
                <span class="badge">Effort: {effortLabels[item.effort]}</span>
              </div>
              <h3><a href={`#${item.id}`}>{item.title}</a></h3>
              <p class="item__why">{item.why}</p>
              <dl>
                <div><dt>What</dt><dd>{item.what}</dd></div>
                <div><dt>Where</dt><dd>{item.where}</dd></div>
              </dl>
              {item.substances && (
                <ul class="chips" aria-label="Substances">
                  {item.substances.map((key) => <li>{labels[key] ?? key}</li>)}
                </ul>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))}

    <section class="group" id="legal-review" aria-labelledby="legal-review-title">
      <div class="group__head">
        <h2 id="legal-review-title">Legal data review</h2>
        <p>
          The legal status of every substance in {review.length} European countries was compiled
          with sourced web research. Entries marked low confidence or unknown are listed first;
          everything else should still be checked by someone who knows the country.
        </p>
      </div>
      {review.length === 0 ? (
        <p class="empty">No legality data yet.</p>
      ) : (
        <div class="review">
          {review.map((country) => (
            <details class="country" open={country.entries.length > 0 && country.entries.length >= 3}>
              <summary>
                <span class="country__name"><span aria-hidden="true">{countryFlag(country.code)}</span> {country.name}</span>
                <span class="country__count">
                  {country.entries.length > 0 ? `${country.entries.length} to check` : "No low-confidence entries"}
                  <span class="muted"> · {country.medium} medium</span>
                </span>
              </summary>
              {country.entries.length > 0 && (
                <ul>
                  {country.entries.map(([key, entry]) => (
                    <li>
                      <strong>{labels[key] ?? key}</strong>
                      <span class={`status status--${entry.status}`}>{entry.status}</span>
                      <span class="muted">{entry.confidence ?? "no confidence"}</span>
                      {entry.note && <p>{entry.note}</p>}
                    </li>
                  ))}
                </ul>
              )}
            </details>
          ))}
        </div>
      )}
    </section>

    <Footer locale="en" variant="wide" />
  </main>

  <script>
    const filters = document.querySelector<HTMLElement>("[data-filters]");
    filters?.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-filter]");
      if (!button) return;
      const filter = button.dataset.filter;
      filters.querySelectorAll("[data-filter]").forEach((other) => {
        other.setAttribute("aria-pressed", other === button ? "true" : "false");
      });
      document.querySelectorAll<HTMLElement>("[data-impact]").forEach((item) => {
        item.hidden = filter !== "all" && item.dataset.impact !== filter;
      });
      document.querySelectorAll<HTMLElement>(".group:not(#legal-review)").forEach((group) => {
        group.hidden = !group.querySelector("[data-impact]:not([hidden])");
      });
    });
  </script>
</Layout>

<style>
  .improvements {
    --critical: #f87171;
    --high: #fb923c;
    --medium: #60a5fa;
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 16px 0;
    color: var(--color-fg);
  }

  .hero {
    display: grid;
    gap: 14px;
    margin-bottom: 40px;
  }

  .eyebrow {
    margin: 0;
    color: var(--color-fg-mute);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(32px, 6vw, 56px);
    font-weight: 850;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .lede {
    max-width: 44rem;
    margin: 0;
    color: var(--color-fg-mute);
    font-size: 17px;
    line-height: 1.5;
  }

  .summary,
  .filters,
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .summary li {
    padding: 8px 14px;
    border: 1px solid color-mix(in oklab, var(--color-fg) 12%, transparent);
    border-radius: 999px;
    color: var(--color-fg-mute);
    font-size: 14px;
  }

  .summary strong {
    color: var(--color-fg);
    font-size: 16px;
  }

  .summary .impact-critical strong { color: var(--critical); }
  .summary .impact-high strong { color: var(--high); }
  .summary .impact-medium strong { color: var(--medium); }

  .filters button {
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid color-mix(in oklab, var(--color-fg) 14%, transparent);
    border-radius: 999px;
    color: var(--color-fg-mute);
    background: transparent;
    font: inherit;
    font-size: 13px;
    font-weight: 750;
    cursor: pointer;
  }

  .filters button[aria-pressed="true"] {
    color: var(--color-ink);
    background: var(--color-fg);
    border-color: var(--color-fg);
  }

  .toc a {
    color: var(--color-fg-mute);
    font-size: 13px;
  }

  .toc a:hover {
    color: var(--color-fg);
  }

  .group {
    margin-bottom: 48px;
    scroll-margin-top: 80px;
  }

  .group[hidden] {
    display: none;
  }

  .group__head {
    max-width: 46rem;
    margin-bottom: 16px;
  }

  .group__head h2 {
    margin: 0 0 6px;
    font-size: 24px;
    font-weight: 850;
    letter-spacing: -0.015em;
  }

  .group__head p {
    margin: 0;
    color: var(--color-fg-mute);
    line-height: 1.5;
  }

  .items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    --accent: var(--medium);
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 16px 18px;
    border: 1px solid color-mix(in oklab, var(--color-fg) 10%, transparent);
    border-top: 3px solid var(--accent);
    border-radius: 16px;
    background: color-mix(in oklab, var(--color-fg) 3.5%, var(--color-ink));
    scroll-margin-top: 80px;
  }

  .item[hidden] {
    display: none;
  }

  .item.impact-critical { --accent: var(--critical); }
  .item.impact-high { --accent: var(--high); }

  .item__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .badge {
    padding: 3px 9px;
    border-radius: 999px;
    color: var(--color-fg-mute);
    background: color-mix(in oklab, var(--color-fg) 7%, transparent);
    font-size: 11px;
    font-weight: 750;
  }

  .badge--impact {
    color: var(--color-ink);
    background: var(--accent);
  }

  .badge--status.is-started {
    color: var(--color-fg);
    background: color-mix(in oklab, #4ade80 30%, transparent);
  }

  .item h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.25;
  }

  .item h3 a {
    color: inherit;
    text-decoration: none;
  }

  .item__why {
    margin: 0;
    color: var(--color-fg);
    line-height: 1.45;
  }

  .item dl {
    display: grid;
    gap: 8px;
    margin: 0;
  }

  .item dt {
    color: var(--color-fg-mute);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .item dd {
    margin: 2px 0 0;
    color: color-mix(in oklab, var(--color-fg) 82%, transparent);
    font-size: 14px;
    line-height: 1.45;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 2px 8px;
    border: 1px solid color-mix(in oklab, var(--color-fg) 14%, transparent);
    border-radius: 999px;
    color: var(--color-fg-mute);
    font-size: 12px;
  }

  .review {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 8px;
    align-items: start;
  }

  .country {
    border: 1px solid color-mix(in oklab, var(--color-fg) 10%, transparent);
    border-radius: 14px;
    background: color-mix(in oklab, var(--color-fg) 3%, var(--color-ink));
  }

  .country summary {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 14px;
    cursor: pointer;
  }

  .country__name {
    font-weight: 800;
  }

  .country__count {
    color: var(--color-fg);
    font-size: 13px;
    white-space: nowrap;
  }

  .country ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0 14px 14px;
    list-style: none;
  }

  .country li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 8px;
    font-size: 14px;
  }

  .country li p {
    flex-basis: 100%;
    margin: 0;
    color: var(--color-fg-mute);
    font-size: 13px;
    line-height: 1.4;
  }

  .status {
    padding: 1px 7px;
    border-radius: 999px;
    color: var(--color-ink);
    background: #a1a1aa;
    font-size: 11px;
    font-weight: 800;
  }

  .status--legal { background: #4ade80; }
  .status--medical { background: #60a5fa; }
  .status--decriminalised { background: #facc15; }
  .status--grey { background: #cbd5e1; }
  .status--illegal { background: #f87171; }

  .muted {
    color: var(--color-fg-mute);
    font-size: 12px;
  }

  .empty {
    color: var(--color-fg-mute);
  }
</style>
